<?xml version="1.0" encoding="UTF-8" ?>

<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TP03_Rastreamento.App">

    <Application.Resources>

        <ResourceDictionary>

            <!-- Cores principais -->
            <Color x:Key="CorPrimaria">#FF6A00</Color>
            <Color x:Key="CorPrimariaEscura">#E85D00</Color>

            <!-- Fundos -->
            <Color x:Key="CorFundo">#F5F5F5</Color>
            <Color x:Key="CorCartao">#FFFFFF</Color>

            <!-- Textos -->
            <Color x:Key="CorTexto">#222222</Color>
            <Color x:Key="CorTextoSecundario">#666666</Color>

            <!-- Outros -->
            <Color x:Key="CorBorda">#E5E5E5</Color>
            <Color x:Key="CorSucesso">#16A34A</Color>
            <Color x:Key="CorErro">#DC2626</Color>

        </ResourceDictionary>

    </Application.Resources>

</Application>